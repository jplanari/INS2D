V_total = [uh_total vh_total]'; %[uh_total; vh_total];
snapshots_V_total = [test_snapshots.uh_total(snapshot_indx,:) test_snapshots.vh_total(snapshot_indx,:)]';

B = options.rom.B;
Om = options.grid.Om;
F_inhom = options.rom.F_inhom;

%% compute best approximation and error
V_best = basis*(basis'*(Om.*(snapshots_V_total))) ... % homogeneous part
       + F_inhom*((F_inhom'*(Om.*(F_inhom))\(F_inhom*(Om.*snapshots_V_total)))); % inhomogeneous part

error_V_best = weightedL2norm(V_best - snapshots_V_total,Om);

color = 'r';
linestyle = '--';
linewidth = 3;
name = "best"

figure
plot(t_snapshot,error_V_best,'color',color,'linestyle', linestyle, 'linewidth', linewidth,'displayname',name);


%% compute ROM error
error_V_ROM = zeros(length(time),1);
for i=length(time)
    t = times(i);
    V_FOM = interpolate(t,snapshots_V_total,t_snapshots);
    error_V_ROM(i) = weightedL2norm(V_FOM-V_ROM,Om);
end

linestyle = '-';

plot(times,     error_V_ROM,'color',color,'linestyle', linestyle, 'linewidth', linewidth,'displayname',name);



set(gca,'Yscale','log');
xlabel('t')
    set(gcf, 'Position', [100, 100, 400, 300])
% legend('show','NumColumns',2,'Orientation','horizontal')
legend('show','NumColumns',3,'Orientation','vertical')
    set(gcf, 'Position', [100, 100, 400, 300])
    ylim([1e-9 1])
grid on